rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Proposal attachments: any signed-in user can read them (approvers need
    // to open the file), but uploads are capped and limited to document and
    // image types so the bucket cannot be used as general storage.
    match /proposals/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && (
                     request.resource.contentType.matches('application/pdf')
                     || request.resource.contentType.matches('image/.*')
                     || request.resource.contentType.matches('application/vnd.*')
                     || request.resource.contentType.matches('application/msword')
                     || request.resource.contentType.matches('text/csv')
                   );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
