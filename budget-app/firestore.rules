rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SuperAdmin';
    }

    // Proposals and user profiles keep the existing posture: any signed-in
    // member of the organisation may read and write them.
    match /proposals/{proposalId} {
      allow read, write: if isSignedIn();
    }

    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // Budget ceilings are a financial control. Everyone signed in has to be
    // able to read them — the submission form checks a proposal against the
    // pagu before it is sent — but only a Super Admin may set them.
    //
    // Note: this cannot be layered under a `/{document=**}` catch-all. Rules
    // are OR-ed, so a permissive catch-all would grant the write anyway; the
    // collections above are therefore listed explicitly instead.
    match /budgets/{budgetId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}
